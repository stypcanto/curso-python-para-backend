# ─────────────────────────────────────────────────────────────
# URLs limpias para el sitio de apuntes (VitePress) en hosting
# tipo Hostinger (LiteSpeed/Apache). Hace que /01-Clases/tema sirva
# el archivo tema.html sin mostrar la extensión.
#
# Va en public/.htaccess → VitePress lo copia a la raíz del build,
# así se sube junto con el sitio. Sin él, las páginas internas dan 404.
# (En hosting estático que NO usa Apache/LiteSpeed no hace daño.)
# ─────────────────────────────────────────────────────────────

Options -MultiViews
RewriteEngine On

ErrorDocument 404 /404.html

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|svg|png|jpg|jpeg|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
